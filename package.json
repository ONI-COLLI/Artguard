{
  "name": "artguard-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ArtGuard — a local artwork marketplace and creator workspace",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "finance:model": "node scripts/finance-model.mjs",
    "test:finance-model": "node --test tests/finance-model.test.mjs",
    "demo:defense": "node scripts/defense-live.mjs",
    "test:defense:unit": "vitest run tests/demo-session.test.tsx tests/blockchain-checkout.test.tsx tests/revenue-sharing.test.tsx tests/buyer-license.test.tsx tests/escrow-ui.test.tsx --maxWorkers=1 --no-file-parallelism",
    "test:defense:contracts": "tsx --test tests/escrow.test.ts",
    "scene": "node demos/industrial-scene/serve.mjs",
    "scene:test": "node --test demos/industrial-scene/yard.test.mjs",
    "demo:setup": "node --env-file-if-exists=.env --import tsx scripts/demo-setup.ts",
    "demo:accounts": "node --env-file-if-exists=.env --import tsx scripts/demo-accounts.ts",
    "verify:purchase": "node --import tsx scripts/verify-purchase.ts",
    "accounting": "node --env-file-if-exists=.env --import tsx scripts/accounting.ts",
    "mail": "node --env-file-if-exists=.env scripts/mail.mjs",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "chain": "node --env-file-if-exists=.env scripts/local-chain.mjs",
    "chain:subscriptions": "node --env-file-if-exists=.env scripts/upgrade-subscriptions.mjs",
    "chain:promotions": "node --env-file-if-exists=.env scripts/upgrade-promotions.mjs",
    "dev:full": "concurrently -k -n chain,app \"npm run chain\" \"npm run dev\"",
    "test:blockchain": "tsx --test --test-concurrency=1 tests/blockchain.test.ts tests/escrow.test.ts",
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start:production": "node --env-file-if-exists=.env dist/server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "npm run typecheck",
    "test": "npm run test:unit && npm run test:api && npm run test:blockchain && npm run test:deployment && npm run test:finance-model",
    "test:unit": "vitest run",
    "test:deployment": "npm run build && tsx --test tests/deployment.test.ts",
    "test:api": "tsx --test --test-concurrency=1 tests/server.test.ts tests/platform.test.ts tests/accounting.test.ts tests/exchange.test.ts tests/gallery.test.ts tests/home.test.ts tests/blockchain-demo.test.ts tests/public-chain-proof.test.ts tests/staff-oauth.test.ts tests/public-hosting.test.ts tests/prototype-review.test.ts tests/presentation-evidence.test.ts tests/defense-guard.test.ts",
    "format": "prettier --write src server shared tests scripts *.json *.ts index.html README.md",
    "format:check": "prettier --check src server shared tests scripts *.json *.ts index.html README.md",
    "chain:licenses": "node --env-file-if-exists=.env --import tsx scripts/upgrade-licenses.ts",
    "chain:escrow": "node --env-file-if-exists=.env --import tsx scripts/upgrade-escrow.ts",
    "public:start": "node --import tsx scripts/public-server.mjs",
    "public:source": "node scripts/export-public-source.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "solc": "0.8.37",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@tanstack/react-query": "^5.104.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.61.0",
    "multer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "viem": "^2.57.7",
    "wagmi": "^3.7.9",
    "zod": "^4.6.7"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "optionalDependencies": {
    "@foundry-rs/anvil-darwin-amd64": "1.7.1",
    "@foundry-rs/anvil-darwin-arm64": "1.7.1",
    "@foundry-rs/anvil-linux-amd64": "1.7.1",
    "@foundry-rs/anvil-linux-arm64": "1.7.1",
    "@foundry-rs/anvil-win32-amd64": "1.7.1"
  }
}
