PORT=3000
# PUBLIC_ORIGIN=https://your-public-host.example
# ARTGUARD_RPC_URL=http://127.0.0.1:8555
# ARTGUARD_PUBLIC_DEMO=true  # Use only an isolated runtime data directory.
# ARTGUARD_SOURCE_MANIFEST=/absolute/path/runtime/public-demo/source-manifest.private.json
# ARTGUARD_DATA_DIR=C:/path/to/local/data
# COOKIE_SECURE=true  # Enable only behind HTTPS.

# Social sign-in is disabled until a provider has both credentials.
# Do not prefix secrets with VITE_. Never commit .env.
OAUTH_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Set the version selected in your Meta app dashboard, e.g. vNN.N.
FACEBOOK_GRAPH_VERSION=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
